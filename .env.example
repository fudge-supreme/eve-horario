# Copia este archivo a .env y llena los valores reales.
# .env nunca se sube al repo (ver .gitignore).

# Con Supabase local (`supabase start`), estos valores los imprime la terminal
# al arrancar. Con un proyecto cloud, están en Supabase Dashboard → Settings → API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=reemplaza-con-tu-anon-key

# Llave pública VAPID para activar notificaciones push (Fase 5).
# Generar con: npm run vapid -- la privada NUNCA va aquí, va como
# secreto de Supabase (ver supabase/.env.example y el output del script).
VITE_VAPID_PUBLIC_KEY=reemplaza-con-tu-vapid-public-key
