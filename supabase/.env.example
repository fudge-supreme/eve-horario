# Copia a supabase/.env para desarrollo local (supabase/.env nunca se
# sube al repo). En producción estos mismos valores se suben con
# `supabase secrets set NOMBRE=valor` -- ver scripts/generate-vapid.js.
VAPID_PUBLIC_KEY=reemplaza-con-tu-vapid-public-key
VAPID_PRIVATE_KEY=reemplaza-con-tu-vapid-private-key
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Secreto compartido que dispatch-reminders exige en el header
# x-cron-secret -- la función corre con verify_jwt=false (la dispara
# pg_cron, no una usuaria con sesión), así que este secreto es lo único
# que evita que cualquiera en internet la dispare a mano.
CRON_SECRET=reemplaza-con-una-cadena-larga-al-azar
